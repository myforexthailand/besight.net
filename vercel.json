{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/customer-sync/",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/spdr-sync/",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/trade-log-snapshot/",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/lot-renewals/",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/member-lots-snapshot/",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/activity-scores/",
      "schedule": "0 2 * * *"
    }
  ]
}
